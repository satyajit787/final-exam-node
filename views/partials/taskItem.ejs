<div class="task-card">
    <div class="task-card-header">
        <h3 class="task-title"><%= task.title %></h3>
        <span class="task-category"><%= task.category ? task.category.name : 'General' %></span>
    </div>

    <% if (task.description) { %>
        <p class="task-description"><%= task.description %></p>
    <% } %>

    <div class="task-card-footer">
        <div class="task-meta">
            <span class="status-badge 
                <% if (task.status === 'Completed') { %>status-completed
                <% } else if (task.status === 'In Progress') { %>status-inprogress
                <% } else { %>status-pending<% } %>">
                <%= task.status %>
            </span>

            <% if (isAllTasksView && task.user) { %>
                <span style="margin-left: 10px; color: #555;">
                    Assigned to: <strong><%= task.user.username %></strong>
                </span>
            <% } %>
        </div>

        <div class="task-actions">
            <a href="/tasks/edit/<%= task._id %>" class="btn btn-secondary">Edit</a>
            <a href="/tasks/delete/<%= task._id %>" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this task?');">Delete</a>
        </div>
    </div>
</div>
